-) : View(context, attrs, defStyleAttr) {
-
-    /** 当前要画的记录（按日期升序）。 */
-    private var records: List<BmiRecord> = emptyList()
-
-    /*
-     * resources.displayMetrics 里保存了屏幕的像素密度。
