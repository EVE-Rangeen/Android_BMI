-            val middle = (maxBmi + minBmi) / 2
-            minBmi = middle - 0.5
-            maxBmi = middle + 0.5
-        }
-        val padding = (maxBmi - minBmi) * 0.18   // 上下各留 18% 的空白，让点不贴边
-        val yMin = minBmi - padding
-        val yMax = maxBmi + padding
-        val yRange = yMax - yMin
-
-        // ===== 画横向网格线 + Y 轴刻度文字 =====
-        val gridLines = 4
-        for (i in 0..gridLines) {
