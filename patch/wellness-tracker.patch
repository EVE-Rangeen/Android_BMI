-
-        // ===== 画折线下方的半透明面积 =====
-        val areaPath = Path(linePath)                   // 复制折线路径
-        areaPath.lineTo(xs[records.lastIndex], bottom)  // 连到底部右下角
-        areaPath.lineTo(xs[0], bottom)                  // 再连到底部左下角
