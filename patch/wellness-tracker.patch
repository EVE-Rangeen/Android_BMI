@@ -2,56 +2,53 @@ package com.example.bmi.data
 
 /*
  * ============================================================================
- * AppLanguage.kt —— 应用当前显示的语言
+ * AppLanguage.kt —— App 支持的语言（【语言切换 · 考试可删】）
  * ============================================================================
  * 【这个文件是干什么的】
- *   App 同时支持中文和英文。界面上到底显示中文还是英文，由系统的语言设置决定；
- *   而“用中文还是英文去问 AI”也由这个枚举决定。
+ *   定义 App 只支持两种语言：英文和中文。
+ *   界面文字由 res/values/ 和 res/values-zh-rCN/ 两套资源提供，
+ *   而“现在用的是哪一套”由这个枚举 + LanguageStore 决定。
  *
- * 【枚举（enum）是什么】
- *   enum 就是“只能取几个固定值”的类型。这里 AppLanguage 只能取 ENGLISH 或 CHINESE，
- *   不可能出现第三种情况，这样编译器就能帮我们防止拼错字符串。
+ * 【enum（枚举）是什么】
+ *   enum 就是“只能取几个固定值”的类型。AppLanguage 只能取 ENGLISH 或 CHINESE，
+ *   不可能出现第三种值，写错编译器会直接报错。
  *
- * 【谁在用这个文件】
- *   1. ReportActivity.currentLanguage() 会根据手机语言，创建出 AppLanguage.ENGLISH
- *      或 AppLanguage.CHINESE；
- *   2. PromptBuilder 用它决定“给 AI 的提示词用中文还是英文写”；
- *   3. 界面上的字符串（“高度”“Height”）不是这个文件负责的，那是 Android 的资源系统
- *      根据 values/ 和 values-zh-rCN/ 两个目录自动切换的。
+ * 【tag 是什么】
+ *   tag 是语言的“国际标准代号”，Android 和 Java 都用它：
+ *     en = English，zh = 中文。
+ *   后面用 Locale("en") / Locale("zh") 生成区域对象，交给系统去挑资源目录。
  *
  * ────────────────────────────────────────────────────────────────────────────
- * 【依赖关系】（考试删文件前先看这里）
- *   本文件依赖：无（不 import 任何本项目内的类）。
- *   谁依赖本文件：ReportActivity、PromptBuilder、HealthAdviceRepository、AdviceUiState。
- *   删除指引：AppLanguage 只服务于“AI 回答用中文还是英文”。
- *             砍掉 AI 功能时，连同本文件一起删。
+ * 【依赖关系 / 考试删除指引】
+ *   本文件依赖：无。
+ *   谁依赖本文件：LanguageStore、BaseActivity、PromptBuilder、AdviceActivity。
+ *
+ *   ★ 考试题目【不要求中英文切换】时，按 docs/exam-guide.md 的 A 部分删除：
+ *     - 本文件、LanguageStore.kt、BaseActivity.kt、res/menu/menu_main.xml 里的语言菜单项；
+ *     - MainActivity / HistoryActivity 改回继承 AppCompatActivity。
+ *     （AI 功能也想保留的话，把 AppLanguage 单独留着给 PromptBuilder 用即可。）
  * ────────────────────────────────────────────────────────────────────────────
  */
-enum class AppLanguage {
+enum class AppLanguage(val tag: String) {
 
-    /** 英文 */
-    ENGLISH,
+    /** 英文（对应 res/values/strings.xml）。 */
+    ENGLISH("en"),
 
-    /** 中文 */
-    CHINESE;
+    /** 中文（对应 res/values-zh-rCN/strings.xml）。 */
+    CHINESE("zh");
 
-    /*
-     * companion object 可以理解为“挂在 enum 上的静态工具函数”。
-     * 也就是说：我们不需要 new 一个对象，直接写 AppLanguage.fromLanguageTag(...) 就能调用。
-     */
     companion object {
 
         /**
-         * 把一个“语言标签”转换成 AppLanguage。
+         * 把系统的语言代号转成 AppLanguage。
+         *
+         * @param languageTag 例如 "zh"、"zh-CN"、"en"；也可能拿不到（null）。
+         * @return 以 "zh" 开头的都算中文，其余（含 null）一律算英文。
          *
-         * @param languageTag 例如手机系统给我们的 "zh"（中文）、"en"（英文）。
-         *                    Android 里语言标签可能带地区，比如 "zh-CN"、"en-US"，
-         *                    所以我们只用 startsWith 判断前缀。
-         * @return 以 "zh" 开头的都当成中文，其余一律当英文（简单可靠）。
+         * startsWith("zh", ignoreCase = true) 会忽略大小写，
+         * 所以 "ZH"、"zh-CN"、"zh-TW" 都能识别成中文。
          */
-        fun fromLanguageTag(languageTag: String): AppLanguage =
-            // startsWith(..., ignoreCase = true) 表示“忽略大小写，看字符串是不是以 zh 开头”。
-            // 这样 "ZH"、"zh-CN"、"zh-TW" 都会被识别成中文。
-            if (languageTag.startsWith("zh", ignoreCase = true)) CHINESE else ENGLISH
+        fun fromTag(languageTag: String?): AppLanguage =
+            if (languageTag?.startsWith("zh", ignoreCase = true) == true) CHINESE else ENGLISH
     }
 }
