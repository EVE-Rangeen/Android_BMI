@@ -0,0 +1,37 @@
+package com.example.bmi.data
+
+/*
+ * ============================================================================
+ * WellnessRecord.kt —— 健康日志里的一条记录（纯数据类）
+ * ============================================================================
+ * 【这个文件是干什么的】
+ *   把“某一天的健康记录”打包成一个对象，方便在 Activity 和数据库之间传递。
+ *   它只有四个字段：日期、身体状况、步数、备注，没有任何业务逻辑。
+ *
+ * 【字段设计（考试时最先想清楚这一步）】
+ *   date      日期字符串 "yyyy-MM-dd"，同时是数据库主键 → 同一天只保留最新一条；
+ *   condition 身体状况，用 0/1/2 表示（0=良好，1=一般，2=较差），
+ *             刚好对应 Spinner 的 selectedItemPosition，省掉一次转换；
+ *   steps     当天步数（整数）；
+ *   note      备注，可以为空字符串，但不要用 null（数据库列设了 NOT NULL）。
+ *
+ * >>> 【改题点 C1】这一行 4 个字段就是“一道题要记什么”。
+ *     换题目时第一个动手的地方：改字段名、类型、含义。
+ *     改完必须顺着改：C2（数据库列）→ C3（文案）→ C4（布局）→ C5（校验）
+ *     → C6（组装记录）→ C7（历史显示）→ C9/C10（AI）。
+ *     少改任何一处，要么编译不过，要么运行起来数据串位。
+ *     完整清单和示例见 docs/adapt-to-other-topic.md 第 5、6、7 节。
+ * <<<
+ *
+ * ────────────────────────────────────────────────────────────────────────────
+ * 【依赖关系】
+ *   本文件依赖：无。
+ *   谁依赖本文件：WellnessDbHelper、MainActivity、HistoryActivity。
+ * ────────────────────────────────────────────────────────────────────────────
+ */
+data class WellnessRecord(
+    val date: String,
+    val condition: Int,   // 【改题点 C1】换题目就改这里
+    val steps: Int,       // 【改题点 C1】例如改成 waterMl: Int / amount: Double
+    val note: String
+)
diff --git a/app/src/main/java/com/example/bmi/ui/advice/AdviceUiState.kt b/app/src/main/java/com/example/bmi/ui/advice/AdviceUiState.kt
new file mode 100644
