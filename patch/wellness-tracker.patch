-        // ===== 画折线路径 =====
-        val linePath = Path()
-        records.indices.forEach { i ->
-            if (i == 0) linePath.moveTo(xs[i], ys[i])   // 起点：移到第一个点
-            else linePath.lineTo(xs[i], ys[i])          // 之后：连线到下一个点
