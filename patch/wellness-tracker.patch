diff --git a/app/src/main/res/layout-land/activity_main.xml b/app/src/main/res/layout-land/activity_main.xml
deleted file mode 100644
index b8475e3..0000000
--- a/app/src/main/res/layout-land/activity_main.xml
+++ /dev/null
@@ -1,168 +0,0 @@
-<?xml version="1.0" encoding="utf-8"?>
-<!--
-  ============================================================================
-  activity_main.xml（横屏版，放在 layout-land/ 目录）
-  ============================================================================
-  【为什么有 layout-land 这个目录】
-    Android 会根据屏幕方向自动选择布局：
-      - 竖屏 → 用 res/layout/activity_main.xml；
-      - 横屏 → 用 res/layout-land/activity_main.xml（就是本文件）。
-    两个文件的控件 id 必须完全一样（heightET、weightET、ageET、genderSpinner、reportBtn…），
-    这样 MainActivity 里的 findViewById(R.id.xxx) 在横竖屏都能找到同一个控件。
-
-  【本布局用 LinearLayout（线性布局）】
-    横屏时屏幕更宽，适合把“图标”放在左边、把“表单”放右边，所以这里用
-    LinearLayout + orientation="horizontal"（水平排列）来左右分栏。
--->
-<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
-    xmlns:app="http://schemas.android.com/apk/res-auto"
-    xmlns:tools="http://schemas.android.com/tools"
-    android:layout_width="match_parent"
-    android:layout_height="match_parent"
-    android:orientation="horizontal"
-    android:gravity="center_vertical"
-    android:padding="16dp"
-    tools:context=".MainActivity">
-
-    <!-- 左边：BMI 图标（id 与竖屏一致：imageView）。 -->
-    <ImageView
-        android:id="@+id/imageView"
-        android:layout_width="wrap_content"
-        android:layout_height="120dp"
-        android:layout_marginEnd="24dp"
-        android:adjustViewBounds="true"
-        android:contentDescription="@string/bmi_icon"
-        app:srcCompat="@drawable/icon_128" />
-
-    <!--
-      右边：竖排的表单。
-      layout_width="0dp" + layout_weight="1" 表示“占满图标之外的所有剩余宽度”。
-    -->
-    <LinearLayout
-        android:layout_width="0dp"
-        android:layout_height="wrap_content"
-        android:layout_weight="1"
-        android:orientation="vertical">
-
-        <!-- 每一行 = 一个水平 LinearLayout：左边标签 + 右边输入框。 -->
-
-        <LinearLayout
-            android:layout_width="match_parent"
-            android:layout_height="wrap_content"
-            android:gravity="center_vertical"
-            android:orientation="horizontal">
-
-            <TextView
-                android:id="@+id/textView7"
-                android:layout_width="90dp"
-                android:layout_height="wrap_content"
-                android:text="@string/bmi_height"
-                android:textSize="16sp" />
-
-            <!-- 身高输入框，id 与竖屏一致：heightET。 -->
-            <EditText
-                android:id="@+id/heightET"
-                android:layout_width="0dp"
-                android:layout_height="wrap_content"
-                android:layout_weight="1"
-                android:inputType="numberDecimal"
-                android:hint="@string/bmi_height" />
-        </LinearLayout>
-
-        <LinearLayout
-            android:layout_width="match_parent"
-            android:layout_height="wrap_content"
-            android:layout_marginTop="8dp"
-            android:gravity="center_vertical"
-            android:orientation="horizontal">
-
-            <TextView
-                android:id="@+id/textView2"
-                android:layout_width="90dp"
-                android:layout_height="wrap_content"
-                android:text="@string/bmi_weight"
-                android:textSize="16sp" />
-
-            <!-- 体重输入框，id：weightET。 -->
-            <EditText
-                android:id="@+id/weightET"
-                android:layout_width="0dp"
-                android:layout_height="wrap_content"
-                android:layout_weight="1"
-                android:inputType="numberDecimal"
-                android:hint="@string/bmi_weight" />
-        </LinearLayout>
-
-        <LinearLayout
-            android:layout_width="match_parent"
-            android:layout_height="wrap_content"
-            android:layout_marginTop="8dp"
-            android:gravity="center_vertical"
-            android:orientation="horizontal">
-
-            <TextView
-                android:id="@+id/textView3"
-                android:layout_width="90dp"
-                android:layout_height="wrap_content"
-                android:text="@string/bmi_age"
-                android:textSize="16sp" />
-
-            <!-- 年龄输入框，id：ageET。 -->
-            <EditText
-                android:id="@+id/ageET"
-                android:layout_width="0dp"
-                android:layout_height="wrap_content"
-                android:layout_weight="1"
-                android:inputType="number"
-                android:hint="@string/bmi_age" />
-        </LinearLayout>
-
-        <LinearLayout
-            android:layout_width="match_parent"
-            android:layout_height="wrap_content"
-            android:layout_marginTop="8dp"
-            android:gravity="center_vertical"
-            android:orientation="horizontal">
-
-            <TextView
-                android:id="@+id/textView"
-                android:layout_width="90dp"
-                android:layout_height="wrap_content"
-                android:text="@string/bmi_gender"
-                android:textSize="16sp" />
-
-            <!-- 性别下拉框，id：genderSpinner。 -->
-            <Spinner
-                android:id="@+id/genderSpinner"
-                android:layout_width="0dp"
-                android:layout_height="wrap_content"
-                android:layout_weight="1"
-                android:entries="@array/gender"
-                android:spinnerMode="dropdown" />
-        </LinearLayout>
-
-        <LinearLayout
-            android:layout_width="match_parent"
-            android:layout_height="wrap_content"
-            android:layout_marginTop="12dp"
-            android:orientation="horizontal">
-
-            <!-- “查看报告”按钮，id：reportBtn。 -->
-            <Button
-                android:id="@+id/reportBtn"
-                android:layout_width="wrap_content"
-                android:layout_height="wrap_content"
-                android:text="@string/bmi_btn"
-                android:textSize="12sp" />
-
-            <!-- “关于”按钮，id：aboutBtn。 -->
-            <Button
-                android:id="@+id/aboutBtn"
-                android:layout_width="wrap_content"
-                android:layout_height="wrap_content"
-                android:layout_marginStart="12dp"
-                android:text="@string/about_button"
-                android:textSize="12sp" />
-        </LinearLayout>
-    </LinearLayout>
-</LinearLayout>
