-            val y = bottom - (bottom - top) * i / gridLines
-            canvas.drawLine(left, y, right, y, gridPaint)   // 画一条横线
-
-            // 这条线对应的 BMI 数值。
-            val value = yMin + yRange * i / gridLines
-            canvas.drawText(
-                String.format(Locale.US, "%.1f", value),   // 保留 1 位小数
