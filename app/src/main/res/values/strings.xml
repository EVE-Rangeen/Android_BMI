<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  strings.xml —— 默认（英文）文案资源
  ============================================================================
  【字符串资源 + 多语言机制（考试高频考点）】
    Android 不推荐把文字直接写死在代码里，而是放在 res/values/strings.xml，
    每个字符串给一个 name（key），代码里用 R.string.xxx 引用。

    系统会根据手机语言自动选资源目录：
      - res/values/strings.xml         ：默认文案（本文件，英文）；
      - res/values-zh-rCN/strings.xml  ：中文文案（同名 key、中文 value）。
    手机语言是中文时显示中文，英文时显示英文，代码完全不用改。

  【占位符】
    %1$s = 第 1 个参数是字符串；%1$d = 第 1 个参数是整数。
    代码里用 getString(R.string.wellness_history_summary, 3, 6500) 填值。
    占位符的编号和参数顺序必须一一对应，否则运行时会崩溃。
-->
<resources>
    <string name="app_name">Wellness Tracker</string>

    <!-- ==================== 主界面 ==================== -->
    <string name="wellness_today">Today: %1$s</string>
    <string name="wellness_condition_label">How do you feel today?</string>
    <string name="wellness_condition_good">Good</string>
    <string name="wellness_condition_fair">Fair</string>
    <string name="wellness_condition_poor">Poor</string>
    <string name="wellness_steps_label">Steps today</string>
    <string name="wellness_steps_hint">e.g. 8000</string>
    <string name="wellness_note_label">Notes (optional)</string>
    <string name="wellness_note_hint">Sleep, mood, symptoms…</string>
    <string name="wellness_save">Save today\'s record</string>
    <string name="wellness_view_history">View history</string>
    <string name="wellness_saved">Saved for today.</string>
    <string name="wellness_steps_warning">Please enter a valid step count.</string>

    <!-- 身体状况下拉框的选项，顺序必须和代码里的 0/1/2 对应。 -->
    <string-array name="wellness_condition">
        <item>@string/wellness_condition_good</item>
        <item>@string/wellness_condition_fair</item>
        <item>@string/wellness_condition_poor</item>
    </string-array>

    <!-- ==================== 历史页 ==================== -->
    <string name="wellness_history_title">History</string>
    <string name="wellness_history_empty">No records yet.\nSave today to start your log.</string>
    <string name="wellness_history_summary">%1$d days recorded · average %2$d steps</string>
    <string name="wellness_history_title_row">%1$s · %2$s</string>
    <string name="wellness_history_steps">%1$d steps</string>
</resources>
