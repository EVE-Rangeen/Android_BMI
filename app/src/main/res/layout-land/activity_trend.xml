<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  activity_trend.xml（横屏版，layout-land/）
  ============================================================================
  与竖屏同样的控件 id，横屏时标题与摘要并排放在顶部，图表占满下方。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context=".TrendActivity">

    <!-- 顶部一行：标题 + 摘要。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trend_range"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/trend_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            tools:text="5 records · latest BMI 24.2" />
    </LinearLayout>

    <!-- 图表 + 空状态叠放。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#1F000000"
            app:strokeWidth="1dp">

            <com.example.bmi.ui.trend.BmiTrendChartView
                android:id="@+id/trend_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/trend_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/trend_empty"
            android:textSize="16sp"
            android:elevation="4dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 图例说明。 -->
    <TextView
        android:id="@+id/trend_legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/trend_legend"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />
</LinearLayout>
