<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  activity_report.xml（横屏版，layout-land/）
  ============================================================================
  与竖屏同样的控件 id，只是横屏时改为“左边图、右边文字”的左右分栏布局。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp"
    tools:context=".ReportActivity">

    <!-- 左边：状态图。 -->
    <ImageView
        android:id="@+id/report_image"
        android:layout_width="wrap_content"
        android:layout_height="180dp"
        android:layout_marginEnd="24dp"
        android:adjustViewBounds="true"
        app:srcCompat="@drawable/bot_fit" />

    <!-- 右边：可滚动文字区。 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/report_llm_scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- BMI 数值 -->
            <TextView
                android:id="@+id/report_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                tools:text="Your BMI value is 22.86" />

            <!-- 本地建议 -->
            <TextView
                android:id="@+id/report_advice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="20sp"
                tools:text="You look great!" />

            <!-- AI 建议标题 -->
            <TextView
                android:id="@+id/report_ai_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/report_ai_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 加载转圈 -->
            <ProgressBar
                android:id="@+id/report_llm_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- AI 建议文字 -->
            <TextView
                android:id="@+id/report_llm_advice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textSize="15sp"
                tools:text="1. Eat more vegetables…" />

            <!-- 重试按钮 -->
            <Button
                android:id="@+id/report_llm_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/llm_retry"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
