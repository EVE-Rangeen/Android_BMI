<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".TrendActivity">

    <TextView
        android:id="@+id/trend_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/trend_range"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/trend_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        tools:text="5 records · latest BMI 24.2" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#1F000000"
            app:strokeWidth="1dp">

            <com.example.bmi.ui.trend.BmiTrendChartView
                android:id="@+id/trend_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/trend_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/trend_empty"
            android:textSize="16sp"
            android:elevation="4dp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/trend_legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/trend_legend"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />
</LinearLayout>
