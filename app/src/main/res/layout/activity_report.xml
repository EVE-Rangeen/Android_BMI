<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  activity_report.xml —— 报告页布局（竖屏）
  ============================================================================
  【这个文件是干什么的】
    定义 ReportActivity 的界面：状态图、BMI 数值、本地建议、AI 建议区域。

  【控件 id 与代码的对应关系】
    report_image        → findViewById(R.id.report_image)     状态图
    report_result       → findViewById(R.id.report_result)    BMI 数值
    report_advice       → findViewById(R.id.report_advice)    本地建议
    report_ai_title     → AI 建议标题
    report_llm_progress → AI 加载中的转圈
    report_llm_advice   → AI 返回的建议文字
    report_llm_retry    → AI 失败后的“重试”按钮
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ReportActivity">

    <!-- 状态图（偏瘦/正常/偏重的小图），代码里根据结果切换图片。 -->
    <ImageView
        android:id="@+id/report_image"
        android:layout_width="wrap_content"
        android:layout_height="120dp"
        android:layout_marginTop="24dp"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/bot_fit" />

    <!-- BMI 数值，例如 “Your BMI value is 24.81”。 -->
    <TextView
        android:id="@+id/report_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/report_image"
        tools:text="Your BMI value is 22.86" />

    <!-- 本地建议（偏瘦/正常/偏重），例如 “You look great!”。 -->
    <TextView
        android:id="@+id/report_advice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@+id/report_result"
        app:layout_constraintTop_toBottomOf="@+id/report_result"
        tools:text="You look great!" />

    <!--
      NestedScrollView：可滚动的容器。AI 建议可能很长，超出屏幕时可以上下滚动。
      里面装一个垂直 LinearLayout，依次放：标题、转圈、建议文字、重试按钮。
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/report_llm_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/report_advice">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- AI 建议标题 -->
            <TextView
                android:id="@+id/report_ai_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/report_ai_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 加载转圈；默认 gone（隐藏），加载时由代码设为可见。 -->
            <ProgressBar
                android:id="@+id/report_llm_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- AI 返回的建议文字。 -->
            <TextView
                android:id="@+id/report_llm_advice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textSize="15sp"
                tools:text="1. Eat more vegetables…" />

            <!-- 失败后出现的“重试”按钮；默认隐藏。 -->
            <Button
                android:id="@+id/report_llm_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/llm_retry"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
