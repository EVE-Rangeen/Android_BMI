<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  activity_main.xml —— 健康日志主界面
  ============================================================================
  【这个文件是干什么的】
    定义 MainActivity 的界面：显示今天日期，选择身体状况，填步数和备注，
    底部两个按钮：保存、查看历史。

  【为什么换成 LinearLayout】
    作业原版用 ConstraintLayout，适合“自由摆放”的复杂界面，但要写很多约束属性。
    这个页面就是从上到下排一列控件，用 LinearLayout（orientation="vertical"）
    最简单：谁写在前面谁在上面，加 layout_marginTop 控制间距即可。
    外面再套一层 ScrollView，保证小屏幕或弹出键盘时内容可以滚动。

  【控件 id 与代码的对应关系】
    dateTV            → 显示“今天：2026-11-26”
    conditionSpinner  → 身体状况下拉框（良好/一般/较差）
    stepsET           → 步数输入框
    noteET            → 备注输入框
    saveBtn           → 保存按钮
    historyBtn        → 查看历史按钮
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 当天日期。文字由 MainActivity 用 getString(..., BmiDates.today()) 填进来。 -->
        <TextView
            android:id="@+id/dateTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Today: 2026-11-26" />

        <!-- 身体状况标签。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/wellness_condition_label"
            android:textSize="16sp" />

        <!--
          身体状况下拉框。
          android:entries="@array/wellness_condition" 表示选项来自 strings.xml 里的数组，
          代码里用 conditionSpinner.selectedItemPosition 拿到 0/1/2。
        -->
        <Spinner
            android:id="@+id/conditionSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:entries="@array/wellness_condition"
            android:minHeight="48dp"
            android:spinnerMode="dropdown" />

        <!-- 步数标签。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/wellness_steps_label"
            android:textSize="16sp" />

        <!--
          步数输入框。
          inputType="number" 会弹出数字键盘，并且只允许输入整数（不允许小数点/字母）。
          注意：它只是“限制键盘”，代码里仍然要用 toIntOrNull() 做一次校验。
        -->
        <EditText
            android:id="@+id/stepsET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/wellness_steps_hint"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="7"
            android:minHeight="48dp" />

        <!-- 备注标签。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/wellness_note_label"
            android:textSize="16sp" />

        <!--
          备注输入框。
          textMultiLine 允许换行；gravity="top" 让光标从左上角开始（默认是垂直居中）。
        -->
        <EditText
            android:id="@+id/noteET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top|start"
            android:hint="@string/wellness_note_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" />

        <!-- 保存按钮：点击后写数据库。 -->
        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/wellness_save"
            android:textSize="16sp" />

        <!-- 查看历史按钮：用“描边按钮”和主按钮区分层级。 -->
        <Button
            android:id="@+id/historyBtn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wellness_view_history"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
