<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  strings.xml（中文版，位于 values-zh-rCN/）
  ============================================================================
  【这个目录的作用】
    手机系统语言为中文（zh-CN）时，Android 会优先用这个目录里的资源；
    没有对应的再回落到 res/values/ 里的默认值。
    所以这里必须保持和 res/values/strings.xml 完全相同的 name（key），
    只是把 value 换成中文。
-->
<resources>
    <string name="app_name">健康日志</string>

    <!-- ==================== 主界面 ==================== -->
    <string name="wellness_today">今天：%1$s</string>
    <string name="wellness_condition_label">今天的身体状况</string>
    <string name="wellness_condition_good">良好</string>
    <string name="wellness_condition_fair">一般</string>
    <string name="wellness_condition_poor">较差</string>
    <string name="wellness_steps_label">今日步数</string>
    <string name="wellness_steps_hint">例如 8000</string>
    <string name="wellness_note_label">备注（可选）</string>
    <string name="wellness_note_hint">睡眠、心情、身体不适…</string>
    <string name="wellness_save">保存今天的记录</string>
    <string name="wellness_view_history">查看历史</string>
    <string name="wellness_saved">已保存今天的记录。</string>
    <string name="wellness_steps_warning">请输入有效的步数。</string>

    <string-array name="wellness_condition">
        <item>@string/wellness_condition_good</item>
        <item>@string/wellness_condition_fair</item>
        <item>@string/wellness_condition_poor</item>
    </string-array>

    <!-- ==================== 历史页 ==================== -->
    <string name="wellness_history_title">历史记录</string>
    <string name="wellness_history_empty">暂无记录。\n保存今天的健康日志后，这里就会显示历史。</string>
    <string name="wellness_history_summary">已记录 %1$d 天 · 平均 %2$d 步</string>
    <string name="wellness_history_title_row">%1$s · %2$s</string>
    <string name="wellness_history_steps">%1$d 步</string>
</resources>
