<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  menu_context.xml —— 长按 BMI 图标时弹出的“上下文菜单”
  ============================================================================
  上下文菜单（ContextMenu）的触发方式：
    1. 在 MainActivity.onCreate 里 registerForContextMenu(bmiImage) 注册到某个控件；
    2. 用户长按该控件；
    3. onCreateContextMenu() 把本文件 inflate 成菜单；
    4. 点击项时 onContextItemSelected() 根据 id 处理。

  注意：这里的 id 前缀是 menu_item_（如 menu_item_about），
  和右上角选项菜单的 menu_about 不一样，要区分开。
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 关于 -->
    <item
        android:id="@+id/menu_item_about"
        android:title="@string/about_button" />

    <!-- BMI 趋势 -->
    <item
        android:id="@+id/menu_item_trend"
        android:title="@string/menu_trend" />

    <!-- BMI 维基百科 -->
    <item
        android:id="@+id/menu_item_wiki"
        android:title="@string/menu_wiki" />
</menu>
